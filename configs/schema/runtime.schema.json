{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volleyball.local/config/runtime-v1.schema.json",
  "title": "Volleyball vision resolved runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "platform", "cameras", "calibration", "adapters", "rectification", "detector", "stereo", "recording", "publisher", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "nominal_fps", "source_timeout_ms", "max_consecutive_timeouts", "queue"],
      "properties": {
        "mode": {"enum": ["runtime", "capture", "replay"]},
        "nominal_fps": {"type": "integer", "minimum": 1, "maximum": 1000},
        "source_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "max_consecutive_timeouts": {"type": "integer", "minimum": 0, "maximum": 1000},
        "queue": {
          "type": "object", "additionalProperties": false,
          "required": ["capacity", "overflow_policy"],
          "properties": {
            "capacity": {"type": "integer", "minimum": 1, "maximum": 4096},
            "overflow_policy": {"enum": ["drop_oldest", "block"]}
          }
        }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "accelerator"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "accelerator": {"enum": ["none", "cuda", "cuda_dla"]}
      }
    },
    "cameras": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "transport", "sync", "left", "right"],
      "properties": {
        "backend": {"enum": ["hik_mvs", "recorded"]},
        "transport": {
          "type": "object", "additionalProperties": false,
          "required": ["interface", "grab_strategy", "image_node_num", "embedded_info_clear_rows"],
          "properties": {
            "interface": {"enum": ["usb3", "gige", "recorded"]},
            "grab_strategy": {"enum": ["one_by_one", "recorded"]},
            "image_node_num": {"type": "integer", "minimum": 1, "maximum": 16},
            "embedded_info_clear_rows": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        },
        "sync": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "clock_domain", "trigger_source", "trigger_activation", "gpio_chip", "gpio_line", "pwm_duty_cycle", "frame_identity_source", "estimated_error_ns", "shutter_type", "exposure_timestamp_source", "exposure_delay_status", "exposure_delay_ns", "exposure_delay_uncertainty_ns"],
          "properties": {
            "method": {"enum": ["hardware_trigger", "recorded"]},
            "clock_domain": {"type": "string", "minLength": 1},
            "trigger_source": {"enum": ["Line0", null]},
            "trigger_activation": {"enum": ["RisingEdge", null]},
            "gpio_chip": {"type": ["string", "null"], "minLength": 1},
            "gpio_line": {"type": ["integer", "null"], "minimum": 0},
            "pwm_duty_cycle": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100},
            "frame_identity_source": {"enum": ["hik_frame_spec_info", "recorded"]},
            "estimated_error_ns": {"type": ["integer", "null"], "minimum": 0},
            "shutter_type": {"enum": ["global", "recorded"]},
            "exposure_timestamp_source": {"enum": ["nx_gpio_rising_edge", "recorded"]},
            "exposure_delay_status": {"enum": ["assumed_zero_unmeasured", "measured", "recorded"]},
            "exposure_delay_ns": {"type": "integer", "minimum": 0},
            "exposure_delay_uncertainty_ns": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "left": {"$ref": "#/$defs/camera"},
        "right": {"$ref": "#/$defs/camera"}
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "created_at_utc", "file", "format", "rig_frame"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
        "file": {"$ref": "#/$defs/path"},
        "format": {"const": "opencv_yaml"},
        "rig_frame": {"type": "string", "minLength": 1}
      }
    },
    "adapters": {
      "type": "object", "additionalProperties": false,
      "required": ["mainline_pipeline"],
      "properties": {
        "mainline_pipeline": {
          "type": "object", "additionalProperties": false,
          "required": ["executable", "source_epoch_file"],
          "properties": {
            "executable": {"$ref": "#/$defs/path"},
            "source_epoch_file": {"$ref": "#/$defs/absolute_path"}
          }
        }
      }
    },
    "rectification": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "output_resolution"],
      "properties": {
        "backend": {"enum": ["cuda", "recorded"]},
        "output_resolution": {"$ref": "#/$defs/resolution"}
      }
    },
    "detector": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "model_id", "per_camera", "input_resolution", "input_format", "resize_mode", "confidence_threshold", "nms_iou_threshold", "max_detections", "class_id", "center_method"],
      "properties": {
        "backend": {"enum": ["tensorrt", "recorded"]},
        "model_id": {"type": "string", "minLength": 1},
        "per_camera": {"const": true},
        "input_resolution": {"$ref": "#/$defs/resolution"},
        "input_format": {"const": "bgr8"},
        "resize_mode": {"const": "letterbox"},
        "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "nms_iou_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "max_detections": {"type": "integer", "minimum": 1, "maximum": 10000},
        "class_id": {"type": "integer", "minimum": 0},
        "center_method": {"const": "bbox_center"}
      }
    },
    "stereo": {
      "type": "object", "additionalProperties": false,
      "required": ["association", "triangulation", "min_depth_m", "max_depth_m", "ball_diameter_m"],
      "properties": {
        "association": {
          "type": "object", "additionalProperties": false,
          "required": ["epipolar_tolerance_px", "adaptive_epipolar_height_ratio", "max_size_ratio", "min_shifted_iou", "max_disparity_px", "bbox_scale", "bbox_disparity_consistency_ratio", "bbox_disparity_consistency_min_px", "bbox_disparity_penalty_scale", "record_rejected"],
          "properties": {
            "epipolar_tolerance_px": {"type": "number", "minimum": 0},
            "adaptive_epipolar_height_ratio": {"type": "number", "minimum": 0},
            "max_size_ratio": {"type": "number", "minimum": 1},
            "min_shifted_iou": {"type": "number", "minimum": 0, "maximum": 1},
            "max_disparity_px": {"type": "integer", "minimum": 1, "maximum": 4294967295},
            "bbox_scale": {"type": "number", "exclusiveMinimum": 0},
            "bbox_disparity_consistency_ratio": {"type": "number", "minimum": 0.05},
            "bbox_disparity_consistency_min_px": {"type": "number", "minimum": 5.0},
            "bbox_disparity_penalty_scale": {"type": "number", "minimum": 0},
            "record_rejected": {"type": "boolean"}
          }
        },
        "triangulation": {
          "type": "object", "additionalProperties": false,
          "required": ["backend", "primary_method", "candidate_methods", "fallback_methods", "propagate_covariance", "subpixel", "circle_fit"],
          "properties": {
            "backend": {"enum": ["cuda", "recorded"]},
            "primary_method": {"enum": ["circle_center", "radial_center", "edge_pair_center", "edge_centroid", "bbox_center", "bbox_edges", "recorded"]},
            "candidate_methods": {
              "type": "array",
              "items": {
                "enum": ["circle_center", "radial_center", "edge_pair_center", "edge_centroid", "bbox_center", "bbox_edges"]
              },
              "uniqueItems": true
            },
            "fallback_methods": {"type": "array", "items": {"enum": ["circle_center", "radial_center", "edge_pair_center", "edge_centroid", "bbox_center", "bbox_edges"]}, "uniqueItems": true},
            "propagate_covariance": {"type": "boolean"},
            "subpixel": {
              "type": "object", "additionalProperties": false,
              "required": ["patch_radius", "search_radius_px", "max_points", "min_points", "min_confidence", "max_disparity_delta_px", "max_disparity_delta_ratio", "max_depth_delta_m", "max_stddev_px"],
              "properties": {
                "patch_radius": {"type": "integer", "minimum": 1},
                "search_radius_px": {"type": "integer", "minimum": 1},
                "max_points": {"type": "integer", "minimum": 1},
                "min_points": {"type": "integer", "minimum": 1},
                "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "max_disparity_delta_px": {"type": "number", "minimum": 0.25},
                "max_disparity_delta_ratio": {"type": "number", "minimum": 0},
                "max_depth_delta_m": {"type": "number", "exclusiveMinimum": 0.01},
                "max_stddev_px": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "circle_fit": {
              "type": "object", "additionalProperties": false,
              "required": ["max_roi_pixels"],
              "properties": {
                "max_roi_pixels": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "min_depth_m": {"type": "number", "minimum": 0},
        "max_depth_m": {"type": "number", "exclusiveMinimum": 0},
        "ball_diameter_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "dataset_root", "schema_version", "raw_frames", "loss_policy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "dataset_root": {"$ref": "#/$defs/path"},
        "schema_version": {"const": "2.1.0"},
        "raw_frames": {"enum": ["none", "all"]},
        "loss_policy": {"enum": ["fail_trial", "mark_dropped"]}
      }
    },
    "publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "backend", "topic", "frame_id"],
      "properties": {
        "enabled": {"type": "boolean"},
        "backend": {"enum": ["none", "ros2"]},
        "topic": {"type": "string"},
        "frame_id": {"type": "string"}
      }
    },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["metrics_interval_frames"],
      "properties": {
        "metrics_interval_frames": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "absolute_path": {"type": "string", "minLength": 2, "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "resolution": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false},
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "serial", "index", "resolution", "pixel_format", "exposure_us", "gain_db", "roi"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "serial": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "resolution": {"$ref": "#/$defs/resolution"},
        "pixel_format": {"enum": ["bayer8", "gray8", "bgr8", "rgb8"]},
        "exposure_us": {"type": "number", "minimum": 0},
        "gain_db": {"type": "number"},
        "roi": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer", "minimum": 0},
            "y": {"type": "integer", "minimum": 0},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
